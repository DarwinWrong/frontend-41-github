{
  "scripts": {
    "watch-css": "sass --watch styles/scss/style.scss:styles/css/style.css",
    "watch-min-css": "sass --watch --style compressed styles/scss/style.scss:styles/css/style.min.css",
    "watch": "npm-run-all --parallel watch-css watch-min-css"
  },
  "dependencies": {
    "sass": "^1.83.0"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
